# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (variáveis de ambiente sensíveis)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env

# arquivos SQL e dumps de banco de dados
*.sql
*.dump
*.sqlite
*.db

# chaves e certificados sensíveis
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ===========================================
# meuingrss - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env.local e preencha os valores

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# --- Segredos de Segurança Interna ---
QR_CODE_SECRET=gerar-hash-hmac-secreta-32-caracteres-minimo
CRON_SECRET=token-secreto-para-execucao-de-cron-jobs
TEST_SUITE_SECRET=token-secreto-para-endpoint-de-testes

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token-aqui
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-public-key-aqui
MERCADOPAGO_WEBHOOK_SECRET=seu-webhook-secret-ou-chave-notificacao-aqui

# --- Domínios ---
NEXT_PUBLIC_DOMINIO_PRINCIPAL=meuingrss.local:3000
NEXT_PUBLIC_SUBDOMINIO_DIRETOR=diretor.meuingrss.local:3000
NEXT_PUBLIC_SUBDOMINIO_ADMIN=admin.meuingrss.local:3000
NEXT_PUBLIC_DOMINIO_COOKIE=.meuingrss.local
NEXT_PUBLIC_PROTOCOLO=http

# --- Produção (descomentar quando for para produção) ---
# NEXT_PUBLIC_DOMINIO_PRINCIPAL=meuingrss.com.br
# NEXT_PUBLIC_SUBDOMINIO_DIRETOR=diretor.meuingrss.com.br
# NEXT_PUBLIC_SUBDOMINIO_ADMIN=admin.meuingrss.com.br
# NEXT_PUBLIC_DOMINIO_COOKIE=.meuingrss.com.br
# NEXT_PUBLIC_PROTOCOLO=https
